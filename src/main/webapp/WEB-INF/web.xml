<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <context-param>
        <param-name>db.jdbcUrl</param-name>
        <param-value>jdbc:postgresql://postgres:5432/cms_db</param-value>
    </context-param>

    <context-param>
        <param-name>db.username</param-name>
        <param-value>cms_user</param-value>
    </context-param>

    <context-param>
        <param-name>db.password</param-name>
        <param-value>cms_pw</param-value>
    </context-param>

    <context-param>
        <param-name>password.min.length</param-name>
        <param-value>2</param-value>
    </context-param>

    <context-param>
        <param-name>password.require.uppercase</param-name>
        <param-value>false</param-value>
    </context-param>

    <context-param>
        <param-name>password.require.lowercase</param-name>
        <param-value>false</param-value>
    </context-param>

    <context-param>
        <param-name>password.require.digit</param-name>
        <param-value>false</param-value>
    </context-param>

    <context-param>
        <param-name>password.require.special</param-name>
        <param-value>false</param-value>
    </context-param>

    <context-param>
        <param-name>auth.max.failed.attempts</param-name>
        <param-value>5</param-value>
    </context-param>

    <context-param>
        <param-name>auth.lock.minutes</param-name>
        <param-value>15</param-value>
    </context-param>

    <context-param>
        <param-name>captcha.login.enabled</param-name>
        <param-value>true</param-value>
    </context-param>

    <context-param>
        <param-name>captcha.registration.enabled</param-name>
        <param-value>true</param-value>
    </context-param>

    <listener>
        <listener-class>hu.laci.cms.backend.config.database.DatabaseConfigListener</listener-class>
    </listener>

    <listener>
        <listener-class>hu.laci.cms.backend.config.app.DaoRegistryListener</listener-class>
    </listener>

    <listener>
        <listener-class>hu.laci.cms.backend.config.security.SecurityConfigListener</listener-class>
    </listener>

    <filter>
        <filter-name>requestLoggingFilter</filter-name>
        <filter-class>hu.laci.cms.backend.servlet.filter.RequestLoggingFilter</filter-class>
    </filter>

    <filter-mapping>
        <filter-name>requestLoggingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>exceptionHandlingFilter</filter-name>
        <filter-class>hu.laci.cms.backend.servlet.filter.ExceptionHandlingFilter</filter-class>
    </filter>

    <filter-mapping>
        <filter-name>exceptionHandlingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>corsFilter</filter-name>
        <filter-class>hu.laci.cms.backend.servlet.filter.CorsFilter</filter-class>
        <init-param>
            <param-name>allowedOrigins</param-name>
            <param-value>http://localhost:5173,http://127.0.0.1:5173</param-value>
        </init-param>
    </filter>

    <filter-mapping>
        <filter-name>corsFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>securityHeadersFilter</filter-name>
        <filter-class>hu.laci.cms.backend.servlet.filter.SecurityHeadersFilter</filter-class>
    </filter>

    <filter-mapping>
        <filter-name>securityHeadersFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>characterEncodingFilter</filter-name>
        <filter-class>hu.laci.cms.backend.servlet.filter.CharacterEncodingFilter</filter-class>
    </filter>

    <filter-mapping>
        <filter-name>characterEncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>authFilter</filter-name>
        <filter-class>hu.laci.cms.backend.servlet.filter.AuthFilter</filter-class>
    </filter>

    <filter-mapping>
        <filter-name>authFilter</filter-name>
        <url-pattern>/api/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>httpSessionContextFilter</filter-name>
        <filter-class>hu.laci.cms.backend.servlet.filter.HttpSessionContextFilter</filter-class>
    </filter>

    <filter-mapping>
        <filter-name>httpSessionContextFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>csrfFilter</filter-name>
        <filter-class>hu.laci.cms.backend.servlet.filter.CsrfFilter</filter-class>
    </filter>

    <filter-mapping>
        <filter-name>csrfFilter</filter-name>
        <url-pattern>/api/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>transactionFilter</filter-name>
        <filter-class>hu.laci.cms.backend.servlet.filter.TransactionFilter</filter-class>
    </filter>

    <filter-mapping>
        <filter-name>transactionFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

</web-app>
